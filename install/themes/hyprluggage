set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES="$(dirname "$(dirname "$SCRIPT_DIR")")"
THEMES_DIR="$DOTFILES/themes"
HOOKS_DIR="$SCRIPT_DIR/hooks"
HYPRLUGGAGE_DIR="$HOME/.config/hyprluggage"
CURRENT_LINK="$HYPRLUGGAGE_DIR/current"
THEME_FILE="$HYPRLUGGAGE_DIR/.current-theme"

VERSION="3.2.1"

# colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
RESET='\033[0m'

ok() { echo -e "${GREEN}[OK]${RESET} $1"; }
warn() { echo -e "${YELLOW}[WARN]${RESET} $1"; }
err() { echo -e "${RED}[ERROR]${RESET} $1" >&2; }
info() { echo -e "${BLUE}[INFO]${RESET} $1"; }

notify() {
	command -v notify-send &>/dev/null && notify-send "$1" "$2" ${3:+-i "$3"}
}

current_theme() {
	cat "$THEME_FILE" 2>/dev/null || echo "dynamic"
}

theme_exists() {
	[[ -d "$THEMES_DIR/$1" ]]
}

# Keep in sync with THEME_FORMAT in hyprluggage-import/init.sh
THEME_FORMAT=1

theme_format_of() {
	local dest="$1"
	local file="$dest/theme.toml"
	[[ -f "$file" ]] || { echo ""; return 0; }
	awk -F'=' '
		/^[[:space:]]*format[[:space:]]*=/ {
			gsub(/[[:space:]]/, "", $2)
			print $2
			exit
		}
	' "$file"
}

require_theme_format() {
	local theme="$1"
	local dest="$THEMES_DIR/$theme"
	local got
	got=$(theme_format_of "$dest")
	if [[ -z "$got" ]]; then
		err "theme \"$theme\" has no theme.toml (expected format = $THEME_FORMAT)"
		return 1
	fi
	if [[ "$got" != "$THEME_FORMAT" ]]; then
		err "theme \"$theme\" uses format $got; this Hyprluggage only understands format $THEME_FORMAT"
		return 1
	fi
	return 0
}

list_themes() {
	echo "dynamic"
	for dir in "$THEMES_DIR"/*/; do
		name=$(basename "$dir")
		[[ "$name" != "dynamic" && "$name" != "Wallpapers" ]] && echo "$name"
	done | sort
}

run_hooks() {
	echo "Running hooks..."
	for hook in "$HOOKS_DIR"/*.sh; do
		[[ -x "$hook" ]] || chmod +x "$hook"
		local name
		name=$(basename "$hook" .sh)
		if CURRENT_LINK="$CURRENT_LINK" THEMES_DIR="$THEMES_DIR" bash "$hook" 2>/dev/null; then
			echo -e "  ${GREEN}✓${RESET} ${name#*-}"
		else
			echo -e "  ${CYAN}–${RESET} ${name#*-}"
		fi
	done
}

set_wallpaper() {
	local theme="$1"

	# Dynamic theme uses ~/Wallpapers with matugen
	if [[ "$theme" == "dynamic" ]]; then
		"$HOME/.config/hypr/scripts/change-theme"
		return
	fi

	local wall
	wall=$(find "$THEMES_DIR/$theme/backgrounds" -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | sort -V | head -1)
	[[ -z "$wall" ]] && return

	# shellcheck source=/dev/null
	source "$HOME/.config/hypr/scripts/wallpaper-lib.sh"
	ensure_awww_daemon
	awww img "$wall" --transition-type center --transition-fps 120 --transition-duration 0.8
	ln -sfn "backgrounds/$(basename "$wall")" "$THEMES_DIR/$theme/wallpaper"
	sync_hyprlock_wallpaper "$wall"
}

# ╭───────────────────────────────────────────────────────────────────────╮
# │ Commands                                                              │
# ╰───────────────────────────────────────────────────────────────────────╯

cmd_switch() {
	local theme="$1"

	if [[ -z "$theme" ]]; then
		command -v rofi &>/dev/null || {
			err "rofi is required"
			exit 1
		}
		local theme_picker="$HOME/.config/rofi/scripts/themePicker"
		if [[ -x "$theme_picker" ]]; then
			exec "$theme_picker"
		else
			theme=$(list_themes | rofi -dmenu -i -p "Theme" -config "$HOME/.config/rofi/config.rasi") || exit 0
		fi
	fi

	[[ -z "$theme" ]] && exit 0
	[[ "$theme" == "$(current_theme)" ]] && {
		notify "Already using $theme"
		exit 0
	}
	theme_exists "$theme" || {
		err "Theme not found: $theme"
		exit 1
	}
	require_theme_format "$theme" || exit 1

	info "Switching to $theme..."
	hyprctl keyword misc:disable_autoreload 1 &>/dev/null || true

	mkdir -p "$HYPRLUGGAGE_DIR"
	echo "$theme" >"$THEME_FILE"
	ln -sfn "$THEMES_DIR/$theme" "$CURRENT_LINK"

	# Dynamic theme runs hooks via change-theme -> hyprluggage reload
	if [[ "$theme" != "dynamic" ]]; then
		run_hooks
	fi

	hyprctl keyword misc:disable_autoreload 0 &>/dev/null || true
	set_wallpaper "$theme"

	# Dynamic theme handles its own notification via change-theme script
	if [[ "$theme" != "dynamic" ]]; then
		notify "$theme" "" "$(readlink -f "$THEMES_DIR/$theme/wallpaper" 2>/dev/null)"
	fi
	ok "Switched to $theme"
}

cmd_reload() {
	local theme
	theme=$(current_theme)
	theme_exists "$theme" || {
		err "Theme not found: $theme"
		exit 1
	}
	require_theme_format "$theme" || exit 1
	info "Reloading $theme..."

	mkdir -p "$HYPRLUGGAGE_DIR"
	ln -sfn "$THEMES_DIR/$theme" "$CURRENT_LINK"

	hyprctl keyword misc:disable_autoreload 1 &>/dev/null || true
	run_hooks
	hyprctl keyword misc:disable_autoreload 0 &>/dev/null || true

	ok "Reloaded $theme"
}

cmd_list() {
	local current
	current=$(current_theme)
	echo ""
	for theme in $(list_themes); do
		if [[ "$theme" == "$current" ]]; then
			echo -e "  ${GREEN}●${RESET} $theme (current)"
		else
			echo "  ○ $theme"
		fi
	done
	echo ""
}

cmd_remove() {
	local theme="$1"
	[[ -z "$theme" ]] && {
		err "Usage: hyprluggage remove <theme>"
		exit 1
	}
	theme_exists "$theme" || {
		err "Not found: $theme"
		exit 1
	}
	[[ "$theme" == "dynamic" ]] && {
		err "Can't remove dynamic theme"
		exit 1
	}

	printf 'Delete %s? [y/N] ' "$theme"
	read -r confirm
	[[ "$confirm" != "y" ]] && exit 0

	if [[ "$theme" == "$(current_theme)" ]]; then
		local next
		next=$(list_themes | grep -A1 "^$theme$" | tail -1)
		[[ "$next" == "$theme" ]] && next=$(list_themes | head -1)
		cmd_switch "$next"
	fi

	rm -rf "${THEMES_DIR:?}/$theme"
	ok "Removed $theme"
}

cmd_fix() {
	local theme
	theme=$(current_theme)
	info "Fixing symlinks..."
	theme_exists "$theme" || {
		err "Theme '$theme' not found"
		exit 1
	}

	mkdir -p "$HYPRLUGGAGE_DIR"
	ln -sfn "$THEMES_DIR/$theme" "$CURRENT_LINK"
	run_hooks
	ok "Fixed $theme"
}

# Import command - delegates to hyprluggage-import
cmd_import() {
	"$SCRIPT_DIR/hyprluggage-import/import.sh" "$@"
}

# Read-only health report. Exit 1 only when a real error was found.
cmd_doctor() {
	local doctor_errors=0
	local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprluggage"
	local profile="desktop"
	local theme
	local bin
	local got
	local addr port
	local ufw_out
	local hypr_ver
	local cursor_desktop=""

	doctor_ok() { ok "$1"; }
	doctor_warn() { warn "$1"; }
	doctor_err() {
		err "$1"
		doctor_errors=$((doctor_errors + 1))
	}

	echo ""
	info "Hyprluggage doctor v$VERSION"
	echo ""

	# ── Core binaries ────────────────────────────────────────────────────
	for bin in hyprctl waybar mako rofi kitty awww cliphist wl-paste; do
		if command -v "$bin" &>/dev/null; then
			doctor_ok "binary $bin"
		else
			doctor_err "binary $bin missing"
		fi
	done

	# ── Optional binaries ────────────────────────────────────────────────
	for bin in wayvnc lazydocker easyeffects; do
		if command -v "$bin" &>/dev/null; then
			doctor_ok "optional $bin"
		else
			doctor_warn "optional $bin missing"
		fi
	done
	for cursor_desktop in \
		"$HOME/.local/share/applications/cursor.desktop" \
		"/usr/share/applications/cursor.desktop"; do
		[[ -f "$cursor_desktop" ]] && break
		cursor_desktop=""
	done
	if [[ -n "$cursor_desktop" ]]; then
		doctor_ok "optional Cursor ($cursor_desktop)"
	else
		doctor_warn "optional Cursor desktop file missing"
	fi

	# ── State stubs ──────────────────────────────────────────────────────
	if [[ -f "$state_dir/profile" ]]; then
		profile=$(tr -d '[:space:]' <"$state_dir/profile")
		doctor_ok "profile $profile"
	else
		doctor_err "profile stub missing ($state_dir/profile)"
	fi
	if [[ -f "$state_dir/profile.lua" ]]; then
		doctor_ok "profile.lua"
	else
		doctor_warn "profile.lua missing"
	fi
	if [[ -f "$state_dir/gpu" ]]; then
		doctor_ok "gpu $(tr -d '[:space:]' <"$state_dir/gpu")"
	else
		doctor_warn "gpu stub missing"
	fi
	if [[ -f "$state_dir/dir" ]]; then
		doctor_ok "repo dir $(tr -d '\n' <"$state_dir/dir")"
	else
		doctor_warn "repo dir stub missing ($state_dir/dir)"
	fi

	# ── Theme ────────────────────────────────────────────────────────────
	theme=$(current_theme)
	if theme_exists "$theme"; then
		doctor_ok "theme $theme"
		got=$(theme_format_of "$THEMES_DIR/$theme")
		if [[ -z "$got" ]]; then
			doctor_err "theme \"$theme\" has no theme.toml (expected format = $THEME_FORMAT)"
		elif [[ "$got" != "$THEME_FORMAT" ]]; then
			doctor_err "theme \"$theme\" uses format $got; expected $THEME_FORMAT"
		else
			doctor_ok "theme format $got"
		fi
	else
		doctor_err "theme \"$theme\" not found under $THEMES_DIR"
	fi

	# ── User units ───────────────────────────────────────────────────────
	check_user_unit() {
		local u="$1"
		if ! systemctl --user cat "$u" &>/dev/null; then
			doctor_warn "unit $u not installed"
			return 0
		fi
		if systemctl --user is-enabled --quiet "$u" 2>/dev/null; then
			if systemctl --user is-active --quiet "$u" 2>/dev/null; then
				doctor_ok "unit $u enabled and active"
			elif systemctl --user is-failed --quiet "$u" 2>/dev/null; then
				doctor_err "unit $u enabled but failed"
			else
				doctor_warn "unit $u enabled but inactive"
			fi
		else
			doctor_warn "unit $u not enabled"
		fi
	}
	check_user_unit wayvnc.service
	check_user_unit wayvnc-clipboard-bridge.service
	if command -v sunshine &>/dev/null; then
		check_user_unit sunshine-mod-bridge.service
	fi

	# Session daemons bundle (waybar/mako/awww/…); warn if Hyprland is up but target is down.
	local session_unit=hyprluggage-session.target
	if systemctl --user is-enabled --quiet "$session_unit" 2>/dev/null; then
		if systemctl --user is-active --quiet "$session_unit" 2>/dev/null; then
			doctor_ok "unit $session_unit"
		elif pgrep -x Hyprland >/dev/null 2>&1; then
			doctor_warn "unit $session_unit enabled but inactive while Hyprland is running"
		else
			doctor_warn "unit $session_unit enabled but inactive"
		fi
	else
		doctor_warn "unit $session_unit not enabled"
	fi

	# ── wayvnc config ────────────────────────────────────────────────────
	local wayvnc_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/wayvnc/config"
	if [[ -f "$wayvnc_cfg" ]]; then
		addr=$(awk -F= '/^address=/{print $2; exit}' "$wayvnc_cfg")
		port=$(awk -F= '/^port=/{print $2; exit}' "$wayvnc_cfg")
		addr="${addr:-unset}"
		port="${port:-unset}"
		doctor_ok "wayvnc config listen $addr:$port"
		if [[ "$addr" == "0.0.0.0" ]]; then
			doctor_warn "wayvnc listens on 0.0.0.0; Gatwy is expected to supply TLS and auth"
		fi
		if grep -Eq '^enable_auth[[:space:]]*=[[:space:]]*true' "$wayvnc_cfg" 2>/dev/null; then
			doctor_ok "wayvnc RFB auth on"
		else
			doctor_warn "wayvnc RFB auth off (intentional for noVNC/Gatwy)"
		fi
	else
		doctor_warn "wayvnc config missing ($wayvnc_cfg)"
	fi

	# ── UFW ──────────────────────────────────────────────────────────────
	if command -v ufw &>/dev/null; then
		ufw_out=$(sudo -n ufw status 2>/dev/null || true)
		if [[ -z "$ufw_out" ]]; then
			ufw_out=$(ufw status 2>/dev/null || true)
		fi
		if [[ -z "$ufw_out" ]]; then
			doctor_warn "ufw status unavailable (need sudo?)"
		elif echo "$ufw_out" | grep -qi "Status: active"; then
			doctor_ok "ufw active"
			if echo "$ufw_out" | grep -Eq '22(/tcp)?\b'; then
				doctor_ok "ufw allows SSH (22)"
			else
				doctor_warn "ufw active but no obvious SSH (22) allow"
			fi
		else
			if [[ "$profile" == "laptop" ]]; then
				doctor_warn "ufw inactive (laptop installs normally enable it)"
			else
				doctor_warn "ufw inactive (expected on desktop unless it was already on)"
			fi
		fi
	else
		doctor_warn "ufw not installed"
	fi

	# ── Hyprland ─────────────────────────────────────────────────────────
	if command -v hyprctl &>/dev/null; then
		hypr_ver=$(hyprctl version 2>/dev/null | head -1 || true)
		if [[ -n "$hypr_ver" ]]; then
			doctor_ok "hyprland $hypr_ver"
		elif [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
			doctor_err "hyprctl cannot talk to this Hyprland session"
		else
			doctor_warn "hyprctl has no compositor session (not an error outside Hyprland)"
		fi
	fi

	# ── Git / tags ───────────────────────────────────────────────────────
	local repo describe latest_tag head_sha latest_sha
	repo=$(resolve_repo 2>/dev/null || true)
	if [[ -n "$repo" && -d "$repo/.git" ]]; then
		describe=$(git -C "$repo" describe --tags --always 2>/dev/null || echo "unknown")
		doctor_ok "git $describe"
		if [[ -f "$state_dir/current-ref" ]]; then
			doctor_ok "current-ref $(tr -d '[:space:]' <"$state_dir/current-ref")"
		fi
		latest_tag=$(latest_version_tag "$repo" || true)
		if [[ -n "$latest_tag" ]]; then
			head_sha=$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)
			latest_sha=$(git -C "$repo" rev-parse "$latest_tag^{commit}" 2>/dev/null || true)
			if [[ -z "$head_sha" || -z "$latest_sha" ]]; then
				doctor_warn "could not compare HEAD to $latest_tag"
			elif [[ "$head_sha" == "$latest_sha" ]]; then
				doctor_ok "on latest tag $latest_tag"
			elif git -C "$repo" merge-base --is-ancestor "$head_sha" "$latest_sha" 2>/dev/null; then
				doctor_warn "behind latest tag $latest_tag (run: hyprluggage update)"
			elif git -C "$repo" merge-base --is-ancestor "$latest_sha" "$head_sha" 2>/dev/null; then
				doctor_ok "ahead of latest tag $latest_tag (development)"
			else
				doctor_warn "HEAD diverged from latest tag $latest_tag"
			fi
		else
			doctor_warn "no v* release tags found"
		fi
	else
		doctor_warn "git repo not found for tag checks"
	fi

	echo ""
	if [[ "$doctor_errors" -gt 0 ]]; then
		err "doctor found $doctor_errors problem(s)"
		exit 1
	fi
	ok "doctor found no errors"
}

# ── Update / rollback ────────────────────────────────────────────────────

resolve_repo() {
	local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprluggage"
	local dir
	if [[ -f "$state_dir/dir" ]]; then
		dir=$(tr -d '\n' <"$state_dir/dir")
		if [[ -d "$dir/.git" ]]; then
			printf '%s\n' "$dir"
			return 0
		fi
	fi
	if [[ -d "$DOTFILES/.git" ]]; then
		printf '%s\n' "$DOTFILES"
		return 0
	fi
	err "cannot find hyprluggage git repo (expected $state_dir/dir or $DOTFILES)"
	return 1
}

repo_state_dir() {
	printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/hyprluggage"
}

require_clean_worktree() {
	local repo="$1"
	if ! git -C "$repo" diff-index --quiet HEAD -- 2>/dev/null; then
		err "worktree has tracked changes; commit or stash before update/rollback"
		return 1
	fi
	return 0
}

latest_version_tag() {
	local repo="$1"
	git -C "$repo" tag -l 'v*' --sort=-v:refname | head -1
}

write_state_ref() {
	local name="$1"
	local value="$2"
	local state_dir
	state_dir=$(repo_state_dir)
	mkdir -p "$state_dir"
	printf '%s\n' "$value" >"$state_dir/$name"
}

run_refresh() {
	local repo="$1"
	if [[ -f "$repo/install/refresh.sh" ]]; then
		# shellcheck disable=SC1091
		source "$repo/install/refresh.sh"
		return $?
	fi
	warn "refresh.sh missing at this ref; running packages + stow directly"
	export HYPRLUGGAGE_REFRESH=1
	# shellcheck disable=SC1091
	source "$repo/install/utils.sh"
	# shellcheck disable=SC1091
	source "$repo/install/packages.sh"
	# shellcheck disable=SC1091
	source "$repo/install/stow.sh"
}

checkout_ref() {
	local repo="$1"
	local ref="$2"
	# Detached HEAD at the tag/commit keeps master free for development.
	git -C "$repo" checkout --detach "$ref"
}

cmd_update() {
	local repo
	local target="${1:-}"
	local head_sha target_sha old_desc

	repo=$(resolve_repo) || exit 1
	require_clean_worktree "$repo" || exit 1

	info "Fetching tags from origin..."
	git -C "$repo" fetch origin --tags

	if [[ -z "$target" ]]; then
		target=$(latest_version_tag "$repo" || true)
		if [[ -z "$target" ]]; then
			err "no v* release tags found; tag a release first (e.g. v$VERSION)"
			exit 1
		fi
	fi

	if ! git -C "$repo" rev-parse "$target^{commit}" &>/dev/null; then
		err "unknown ref: $target"
		exit 1
	fi

	head_sha=$(git -C "$repo" rev-parse HEAD)
	target_sha=$(git -C "$repo" rev-parse "$target^{commit}")
	old_desc=$(git -C "$repo" describe --tags --always 2>/dev/null || echo "$head_sha")

	if [[ "$head_sha" == "$target_sha" ]]; then
		ok "already on $target ($old_desc)"
		write_state_ref current-ref "$target"
		exit 0
	fi

	info "Updating $old_desc → $target"
	write_state_ref previous-ref "$head_sha"
	checkout_ref "$repo" "$target"
	write_state_ref current-ref "$target"
	if ! run_refresh "$repo"; then
		err "checked out $target but refresh failed; fix packages/stow and re-run: hyprluggage update $target"
		exit 1
	fi
	ok "updated to $target"
	info "Rollback with: hyprluggage rollback"
}

cmd_rollback() {
	local repo
	local state_dir
	local prev head_sha old_desc

	repo=$(resolve_repo) || exit 1
	require_clean_worktree "$repo" || exit 1

	state_dir=$(repo_state_dir)
	if [[ ! -f "$state_dir/previous-ref" ]]; then
		err "no previous-ref recorded; run hyprluggage update first"
		exit 1
	fi
	prev=$(tr -d '[:space:]' <"$state_dir/previous-ref")
	if [[ -z "$prev" ]]; then
		err "previous-ref is empty"
		exit 1
	fi
	if ! git -C "$repo" rev-parse "$prev^{commit}" &>/dev/null; then
		err "previous-ref not found in git: $prev"
		exit 1
	fi

	head_sha=$(git -C "$repo" rev-parse HEAD)
	old_desc=$(git -C "$repo" describe --tags --always 2>/dev/null || echo "$head_sha")

	if [[ "$head_sha" == "$(git -C "$repo" rev-parse "$prev^{commit}")" ]]; then
		ok "already at previous-ref ($old_desc)"
		exit 0
	fi

	info "Rolling back $old_desc → $prev"
	# Swap so a second rollback can move forward again.
	write_state_ref previous-ref "$head_sha"
	checkout_ref "$repo" "$prev"
	write_state_ref current-ref "$prev"
	if ! run_refresh "$repo"; then
		err "checked out $prev but refresh failed; fix packages/stow and re-run: hyprluggage rollback"
		exit 1
	fi
	ok "rolled back to $prev"
}

