cmd_monitors() {
	local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprluggage"
	local path="$state_dir/monitors-local.lua"
	local sub="${1:-}"

	case "$sub" in
	path)
		echo "$path"
		;;
	save)
		if ! command -v hyprctl >/dev/null 2>&1; then
			err "hyprctl not found (is Hyprland running?)"
			exit 1
		fi
		if ! command -v python3 >/dev/null 2>&1; then
			err "python3 required to parse hyprctl monitors -j"
			exit 1
		fi
		mkdir -p "$state_dir"
		local json_file out_tmp
		json_file=$(mktemp)
		out_tmp=$(mktemp)
		if ! hyprctl monitors all -j >"$json_file" 2>/dev/null; then
			rm -f "$json_file" "$out_tmp"
			err "hyprctl monitors all -j failed"
			exit 1
		fi
		if ! python3 - "$json_file" "$out_tmp" <<'PY'
import json, sys

json_path, out_path = sys.argv[1], sys.argv[2]
monitors = json.loads(open(json_path, encoding="utf-8").read())
by_id = {m.get("id"): m.get("name") for m in monitors if m.get("id") is not None}
lines = [
    "-- Host-local monitor layout (not managed by stow / hyprluggage update).",
    "-- Generated by: hyprluggage monitors save",
    "-- Hand-edit for mirrors/disabled edge cases save cannot express perfectly.",
]
for m in monitors:
    name = m.get("name") or ""
    if not name:
        continue
    if m.get("disabled"):
        lines.append(f'hl.monitor({{ output = "{name}", disabled = true }})')
        continue
    parts = [f'output = "{name}"', 'mode = "preferred"']
    mirror = m.get("mirrorOf")
    if mirror not in (None, "", "none"):
        target = None
        if isinstance(mirror, str) and not mirror.isdigit():
            target = mirror
        else:
            try:
                target = by_id.get(int(mirror))
            except (TypeError, ValueError):
                target = None
        if target:
            parts.append(f'mirror = "{target}"')
        else:
            x, y = m.get("x", 0), m.get("y", 0)
            parts.append(f'position = "{x}x{y}"')
            scale = m.get("scale", 1)
            if isinstance(scale, float) and scale.is_integer():
                scale = int(scale)
            parts.append(f"scale = {scale}")
    else:
        x, y = m.get("x", 0), m.get("y", 0)
        if x != -1 and y != -1:
            parts.append(f'position = "{x}x{y}"')
        scale = m.get("scale", 1)
        if isinstance(scale, float) and scale.is_integer():
            scale = int(scale)
        parts.append(f"scale = {scale}")
    lines.append("hl.monitor({ " + ", ".join(parts) + " })")
open(out_path, "w", encoding="utf-8").write("\n".join(lines) + "\n")
PY
		then
			rm -f "$json_file" "$out_tmp"
			err "failed to generate monitors-local.lua"
			exit 1
		fi
		rm -f "$json_file"
		mv -f "$out_tmp" "$path"
		ok "wrote $path"
		info "reload Hyprland (or log out/in) to apply"
		echo "$path"
		;;
	"" | help | -h | --help)
		cat <<EOF
Usage: hyprluggage monitors <save|path>

  save   Write ~/.local/state/hyprluggage/monitors-local.lua from hyprctl
  path   Print the host-local monitors file path

Shared catch-all lives in stowed monitors.lua; update/stow never touches
monitors-local.lua. Arrange displays, then: hyprluggage monitors save
EOF
		;;
	*)
		err "Unknown monitors subcommand: $sub"
		echo "Try: hyprluggage monitors help"
		exit 1
		;;
	esac
}

cmd_host() {
	local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprluggage"
	local envs_path="$state_dir/envs-local.lua"
	local weather_path="$state_dir/weather-location"
	local wp_example="$DOTFILES/examples/wireplumber/51-audio-priority.conf"
	local wp_dest="$HOME/.config/wireplumber/wireplumber.conf.d/51-audio-priority.conf"
	local sub="${1:-}"

	case "$sub" in
	"" | help | -h | --help)
		cat <<EOF
Host overlays (opt-in; never required for a fresh install)

  New machines are usable with shared defaults. Create overlays only when
  something looks wrong (layout, HiDPI Qt, audio priority, weather).

Paths under $state_dir:
  monitors-local.lua   Per-output layout (scale, position, mirror, disable)
  envs-local.lua       QT scale / xwayland HiDPI (needs logout/login)
  weather-location     Waybar weather city (set via Waybar click)
  session-dirs         Extra roots for tmux sessionX (one path per line)
  waybar-outputs       Waybar output list (one per line; !NAME excludes)

Other host files (outside stow):
  ~/.config/sunshine/sunshine.conf     Moonlight capture output_name
  ~/.config/wireplumber/...            Audio device priority (see below)

Commands:
  hyprluggage host              This map
  hyprluggage host envs         Print envs-local example + path
  hyprluggage host envs --init --hidpi
                                Create envs-local.lua with QT 1.5 (desk HiDPI)
  hyprluggage host monitors     Same as: hyprluggage monitors help
  hyprluggage monitors save     Write monitors-local.lua from hyprctl
  hyprluggage monitors path     Print monitors-local.lua path

WirePlumber (optional):
  mkdir -p ~/.config/wireplumber/wireplumber.conf.d
  cp $wp_example \\
     $wp_dest
  # then edit node.name matches for your DAC / built-in audio

Weather: click the Waybar weather module, or:
  echo 'City, ST' > $weather_path

Tmux session picker extras (optional):
  printf '%s\\n' '~/Projects/work' '~/src/course' > $state_dir/session-dirs

Waybar outputs (optional; skip mirrored capture cards):
  printf '%s\\n' '!HDMI-A-2' '*' > $state_dir/waybar-outputs
  systemctl --user restart waybar.service
EOF
		;;
	envs)
		shift || true
		if [[ "${1:-}" == "--init" ]]; then
			shift || true
			if [[ "${1:-}" != "--hidpi" ]]; then
				err "refusing bare --init (would ship desk HiDPI to laptops)"
				info "for HiDPI desks: hyprluggage host envs --init --hidpi"
				info "or paste a custom snippet from: hyprluggage host envs"
				exit 1
			fi
			if [[ -f "$envs_path" ]]; then
				warn "already exists: $envs_path"
				echo "$envs_path"
				exit 0
			fi
			mkdir -p "$state_dir"
			cat >"$envs_path" <<'EOF'
-- Host-local env / HiDPI (not managed by stow / hyprluggage update).
-- hl.env only applies at compositor launch — logout/login after edits.
-- See: hyprluggage host envs
hl.env("QT_SCALE_FACTOR", "1.5")
hl.config({
	xwayland = {
		force_zero_scaling = true,
	},
})
EOF
			ok "wrote $envs_path"
			info "logout/login for hl.env to apply"
			echo "$envs_path"
			exit 0
		fi
		cat <<EOF
Path: $envs_path
$( [[ -f "$envs_path" ]] && echo "Status: present" || echo "Status: absent (shared defaults)" )

Example for HiDPI desks (paste into that file, then logout/login):

-- Host-local env / HiDPI (not managed by stow / hyprluggage update).
hl.env("QT_SCALE_FACTOR", "1.5")
hl.config({
	xwayland = {
		force_zero_scaling = true,
	},
})

Create with: hyprluggage host envs --init --hidpi
(Laptops usually leave envs-local absent.)
EOF
		;;
	monitors)
		cmd_monitors help
		;;
	*)
		err "Unknown host subcommand: $sub"
		echo "Try: hyprluggage host"
		exit 1
		;;
	esac
}

