case "${1:-help}" in
switch)
	shift
	cmd_switch "$@"
	;;
browse) exec "$SCRIPT_DIR/hyprluggage-tui" --browse-inner ;;
import)
	shift
	cmd_import "$@"
	;;
apply-aether)
	shift
	"$SCRIPT_DIR/hyprluggage-import/import.sh" --aether "$@"
	;;
tui) exec "$SCRIPT_DIR/hyprluggage-tui" ;;
reload) cmd_reload ;;
fix) cmd_fix ;;
doctor) cmd_doctor ;;
update)
	shift
	cmd_update "$@"
	;;
rollback) cmd_rollback ;;
list | ls) cmd_list ;;
current)
	echo ""
	echo -e "  ${GREEN}●${RESET} $(current_theme)"
	"$DOTFILES/scripts/fetch-colors" 2>/dev/null || true
	;;
remove | rm)
	shift
	cmd_remove "$@"
	;;
uninstall) "$SCRIPT_DIR/uninstall.sh" ;;
help | -h | --help) cmd_help ;;
version | -v) cmd_version ;;
*)
	err "Unknown: $1"
	echo "Try: hyprluggage help"
	exit 1
	;;
esac
