#!/usr/bin/bash
# Greetd session: write Hyprland stubs, then start Hyprland via uwsm.
# greetd gives a stripped environment — set XDG_* / D-Bus ourselves.

export PATH="/usr/local/bin:/usr/bin:/bin${HOME:+:$HOME/.local/bin}${PATH:+:$PATH}"
if [[ -z "${HOME:-}" ]]; then
	HOME=$(getent passwd "$(id -un)" | cut -d: -f6)
	export HOME
fi
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S ${XDG_RUNTIME_DIR}/bus ]]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

STATE_DIR="${XDG_STATE_HOME}/hyprluggage"
LOG="$STATE_DIR/session.log"
TMPLOG="/tmp/hyprluggage-session-$(id -u).log"
mkdir -p "$STATE_DIR" 2>/dev/null || true

log() { echo "$*" | tee -a "$TMPLOG" >>"$LOG" 2>/dev/null; }

log "---- $(date -Iseconds) uid=$(id -u) user=$(id -un) home=$HOME ----"
log "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR DBUS=${DBUS_SESSION_BUS_ADDRESS:-unset}"

if [[ -x $HOME/.local/bin/hyprluggage-hw-ensure ]]; then
	"$HOME/.local/bin/hyprluggage-hw-ensure" ensure >>"$TMPLOG" 2>&1 || log "hw-ensure failed ($?)"
fi
if [[ -x $HOME/.local/bin/hypr-vnc-mod ]]; then
	"$HOME/.local/bin/hypr-vnc-mod" ensure >>"$TMPLOG" 2>&1 || log "vnc-mod ensure failed ($?)"
fi

# CachyOS copies Hello into ~/.config/autostart from /etc/skel. Hide it before
# UWSM starts xdg-desktop-autostart.target (Hyprluggage has its own first-run).
mkdir -p "$HOME/.config/autostart"
if [[ -e $HOME/.config/autostart/cachyos-hello.desktop || -e /etc/skel/.config/autostart/cachyos-hello.desktop ]]; then
	printf '[Desktop Entry]\nHidden=true\n' >"$HOME/.config/autostart/cachyos-hello.desktop"
fi

if [[ ! -f $STATE_DIR/profile.lua ]]; then
	echo desktop >"$STATE_DIR/profile"
	printf -- '-- Managed by hyprluggage-session\ndofile("%s/.config/hypr/profiles/desktop.lua")\n' "$HOME" >"$STATE_DIR/profile.lua"
	printf '# Managed by hyprluggage-session\nsource = %s/.config/hypr/profiles/desktop.conf\n' "$HOME" >"$STATE_DIR/profile.conf"
fi
if [[ ! -f $STATE_DIR/gpu.lua ]]; then
	echo other >"$STATE_DIR/gpu"
	printf -- '-- no NVIDIA GPU overlay\n' >"$STATE_DIR/gpu.lua"
	printf '# no NVIDIA GPU overlay\n' >"$STATE_DIR/gpu.conf"
fi
if [[ ! -f $STATE_DIR/vnc-mod-active.lua ]]; then
	printf -- '-- Managed by hypr-vnc-mod — empty when no VNC session\n' >"$STATE_DIR/vnc-mod-active.lua"
fi
if [[ ! -f $STATE_DIR/vnc-mod-active.conf ]]; then
	printf '# Managed by hypr-vnc-mod — empty when no VNC session\n' >"$STATE_DIR/vnc-mod-active.conf"
fi
log "profile=$(cat "$STATE_DIR/profile" 2>/dev/null) gpu=$(cat "$STATE_DIR/gpu" 2>/dev/null)"

in_vm=0
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q; then
	in_vm=1
elif grep -q hypervisor /proc/cpuinfo 2>/dev/null; then
	in_vm=1
fi
if [[ $in_vm -eq 1 ]]; then
	export AQ_NO_MODIFIERS=1
	log "virt detected: AQ_NO_MODIFIERS=1"
	# NVIDIA overlay in a guest makes Aquamarine fail to start the compositor
	if grep -qE 'nvidia\.(conf|lua)' "$STATE_DIR/gpu.conf" "$STATE_DIR/gpu.lua" 2>/dev/null; then
		printf '# no NVIDIA GPU overlay (forced off under virt)\n' >"$STATE_DIR/gpu.conf"
		printf -- '-- no NVIDIA GPU overlay (forced off under virt)\n' >"$STATE_DIR/gpu.lua"
		echo other >"$STATE_DIR/gpu"
		log "cleared nvidia overlay for virt"
	fi
fi

# wayvnc used to be WantedBy=default.target with Wants=graphical-session.target.
# Linger then kept an empty graphical session active, and uwsm refused to start.
WANTS_DIR="$HOME/.config/systemd/user/default.target.wants"
if [[ -L $WANTS_DIR/wayvnc.service || -L $WANTS_DIR/wayvnc-clipboard-bridge.service ]]; then
	log "migrating wayvnc off default.target"
	systemctl --user disable wayvnc.service wayvnc-clipboard-bridge.service >/dev/null 2>&1 || true
	systemctl --user daemon-reload >/dev/null 2>&1 || true
	systemctl --user enable wayvnc.service wayvnc-clipboard-bridge.service >/dev/null 2>&1 || true
fi

if command -v systemctl >/dev/null 2>&1; then
	systemctl --user reset-failed >/dev/null 2>&1 || true
	if systemctl --user is-active -q graphical-session.target 2>/dev/null; then
		log "graphical-session.target already active; stopping leftovers"
		systemctl --user --no-pager --no-legend list-units --state=active >>"$TMPLOG" 2>/dev/null || true
		# Stop wayvnc first — Restart=always + Wants=graphical-session would pull the target back
		systemctl --user stop wayvnc.service wayvnc-clipboard-bridge.service >/dev/null 2>&1 || true
		[[ -x /usr/bin/uwsm ]] && /usr/bin/uwsm stop >/dev/null 2>&1 || true
		systemctl --user stop 'wayland-wm@*.service' 'wayland-session@*.target' \
			graphical-session.target graphical-session-pre.target >/dev/null 2>&1 || true
		systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY HYPRLAND_INSTANCE_SIGNATURE >/dev/null 2>&1 || true
		n=0
		while systemctl --user is-active -q graphical-session.target 2>/dev/null; do
			n=$((n + 1))
			[[ $n -ge 20 ]] && break
			sleep 0.2
		done
		if systemctl --user is-active -q graphical-session.target 2>/dev/null; then
			log "WARN: graphical-session.target still active"
		else
			log "cleared graphical-session.target"
		fi
	fi
fi

if [[ ! -x /usr/bin/uwsm ]]; then
	log "missing /usr/bin/uwsm"
	exit 1
fi

# Match CachyOS hyprland.desktop (Exec=/usr/bin/start-hyprland) with data dirs set
# so uwsm can resolve the desktop file. Log uwsm output — do not exec, so a
# failure is written here instead of only flashing on the TTY.
log "uwsm start hyprland.desktop"
set +e
/usr/bin/uwsm start hyprland.desktop >>"$TMPLOG" 2>&1
rc=$?
set -e
log "uwsm exited $rc"
exit "$rc"
