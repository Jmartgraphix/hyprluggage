#!/usr/bin/bash
# Greetd session: write Hyprland stubs, then start Hyprland via uwsm.
# greetd gives a stripped environment — set XDG_* / D-Bus ourselves.

export PATH="/usr/local/bin:/usr/bin:/bin${HOME:+:$HOME/.local/bin}${PATH:+:$PATH}"
if [[ -z "${HOME:-}" ]]; then
	HOME=$(getent passwd "$(id -un)" | cut -d: -f6)
	export HOME
fi
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S ${XDG_RUNTIME_DIR}/bus ]]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
fi

STATE_DIR="${XDG_STATE_HOME}/hyprluggage"
LOG="$STATE_DIR/session.log"
TMPLOG="/tmp/hyprluggage-session-$(id -u).log"
mkdir -p "$STATE_DIR" 2>/dev/null || true

log() { echo "$*" | tee -a "$TMPLOG" >>"$LOG" 2>/dev/null; }

log "---- $(date -Iseconds) uid=$(id -u) user=$(id -un) home=$HOME ----"
log "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR DBUS=${DBUS_SESSION_BUS_ADDRESS:-unset}"

if [[ -x $HOME/.local/bin/hyprluggage-hw-ensure ]]; then
	"$HOME/.local/bin/hyprluggage-hw-ensure" ensure >>"$TMPLOG" 2>&1 || log "hw-ensure failed ($?)"
fi
if [[ -x $HOME/.local/bin/hypr-vnc-mod ]]; then
	"$HOME/.local/bin/hypr-vnc-mod" ensure >>"$TMPLOG" 2>&1 || log "vnc-mod ensure failed ($?)"
fi

if [[ ! -f $STATE_DIR/profile.conf ]]; then
	echo "source = $HOME/.config/hypr/profiles/desktop.conf" >"$STATE_DIR/profile.conf"
	echo desktop >"$STATE_DIR/profile"
fi
if [[ ! -f $STATE_DIR/gpu.conf ]]; then
	printf '# no NVIDIA GPU overlay\n' >"$STATE_DIR/gpu.conf"
	echo other >"$STATE_DIR/gpu"
fi
if [[ ! -f $STATE_DIR/vnc-mod-active.conf ]]; then
	printf '# Managed by hypr-vnc-mod — empty when no VNC session\n' >"$STATE_DIR/vnc-mod-active.conf"
fi
log "profile=$(cat "$STATE_DIR/profile" 2>/dev/null) gpu=$(cat "$STATE_DIR/gpu" 2>/dev/null)"

in_vm=0
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt -q; then
	in_vm=1
elif grep -q hypervisor /proc/cpuinfo 2>/dev/null; then
	in_vm=1
fi
if [[ $in_vm -eq 1 ]]; then
	export AQ_NO_MODIFIERS=1
	log "virt detected: AQ_NO_MODIFIERS=1"
	# NVIDIA overlay in a guest makes Aquamarine fail to start the compositor
	if grep -q nvidia.conf "$STATE_DIR/gpu.conf" 2>/dev/null; then
		printf '# no NVIDIA GPU overlay (forced off under virt)\n' >"$STATE_DIR/gpu.conf"
		echo other >"$STATE_DIR/gpu"
		log "cleared nvidia overlay for virt"
	fi
fi

# Drop leftover units from earlier failed logins (uwsm then prints a red compositor error)
if command -v systemctl >/dev/null 2>&1; then
	systemctl --user reset-failed >/dev/null 2>&1 || true
fi
if [[ -x /usr/bin/uwsm ]]; then
	/usr/bin/uwsm stop >/dev/null 2>&1 || true
fi

if [[ ! -x /usr/bin/uwsm ]]; then
	log "missing /usr/bin/uwsm"
	exit 1
fi

# Match CachyOS hyprland.desktop (Exec=/usr/bin/start-hyprland) with data dirs set
# so uwsm can resolve the desktop file. Log uwsm output — do not exec, so a
# failure is written here instead of only flashing on the TTY.
log "uwsm start hyprland.desktop"
set +e
/usr/bin/uwsm start hyprland.desktop >>"$TMPLOG" 2>&1
rc=$?
set -e
log "uwsm exited $rc"
exit "$rc"
