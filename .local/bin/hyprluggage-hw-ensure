#!/usr/bin/env bash
# Ensure form-factor + GPU Hyprland stubs exist under ~/.local/state/hyprluggage/
# Same pattern as hypr-vnc-mod ensure — stubs live outside stow so reloads never break.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hyprluggage"
PROFILE_FILE="$STATE_DIR/profile"
GPU_FILE="$STATE_DIR/gpu"
PROFILE_CONF="$STATE_DIR/profile.conf"
GPU_CONF="$STATE_DIR/gpu.conf"
PROFILE_LUA="$STATE_DIR/profile.lua"
GPU_LUA="$STATE_DIR/gpu.lua"
HYPR_PROFILES="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/profiles"

detect_nvidia() {
	# Match display GPUs only (ignore NVIDIA HD Audio)
	lspci 2>/dev/null | grep -iE 'VGA|3D|Display' | grep -qi nvidia
}

detect_laptop() {
	compgen -G '/sys/class/power_supply/BAT*' >/dev/null 2>&1
}

detect_vm() {
	# qemu/kvm, vmware, hyperv, etc. Prefer systemd; fall back to CPUID hypervisor bit.
	# Keep this in &&/|| form so `set -e` cannot abort the script on "not a VM".
	if command -v systemd-detect-virt >/dev/null 2>&1; then
		systemd-detect-virt -q && return 0 || return 1
	fi
	grep -q hypervisor /proc/cpuinfo 2>/dev/null && return 0 || return 1
}

# Default GPU for auto-detect: bare-metal NVIDIA → nvidia; guests → other
# (passthrough/compute cards in a VM are often not Hyprland's display GPU).
default_gpu() {
	if detect_nvidia && ! detect_vm; then
		printf 'nvidia\n'
	else
		printf 'other\n'
	fi
}

write_profile_stub() {
	local profile="$1"
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$profile" >"$PROFILE_FILE"
	cat >"$PROFILE_CONF" <<EOF
# Managed by hyprluggage-hw-ensure — form factor: $profile
source = $HYPR_PROFILES/${profile}.conf
EOF
	cat >"$PROFILE_LUA" <<EOF
-- Managed by hyprluggage-hw-ensure — form factor: $profile
dofile("$HYPR_PROFILES/${profile}.lua")
EOF
}

write_gpu_stub() {
	local gpu="$1"
	mkdir -p "$STATE_DIR"
	printf '%s\n' "$gpu" >"$GPU_FILE"
	if [[ "$gpu" == "nvidia" ]]; then
		cat >"$GPU_CONF" <<EOF
# Managed by hyprluggage-hw-ensure — GPU: nvidia
source = $HYPR_PROFILES/nvidia.conf
EOF
		cat >"$GPU_LUA" <<EOF
-- Managed by hyprluggage-hw-ensure — GPU: nvidia
dofile("$HYPR_PROFILES/nvidia.lua")
EOF
	else
		cat >"$GPU_CONF" <<'EOF'
# Managed by hyprluggage-hw-ensure — no NVIDIA GPU overlay
EOF
		cat >"$GPU_LUA" <<'EOF'
-- Managed by hyprluggage-hw-ensure — no NVIDIA GPU overlay
EOF
	fi
}

normalize_profile() {
	local p="${1:-}"
	case "$p" in
	laptop | desktop) printf '%s\n' "$p" ;;
	*) printf 'desktop\n' ;;
	esac
}

normalize_gpu() {
	local g="${1:-}"
	case "$g" in
	nvidia | other) printf '%s\n' "$g" ;;
	*) default_gpu ;;
	esac
}

cmd_ensure() {
	mkdir -p "$STATE_DIR"
	local profile gpu

	if [[ -f "$PROFILE_FILE" ]]; then
		profile=$(normalize_profile "$(tr -d '[:space:]' <"$PROFILE_FILE")")
	else
		# Missing-stub default: desktop (this machine / streaming-safe)
		profile=desktop
	fi

	if [[ -f "$GPU_FILE" ]]; then
		gpu=$(normalize_gpu "$(tr -d '[:space:]' <"$GPU_FILE")")
	else
		# Prefer NVIDIA on bare metal so a git pull never drops the gaming overlay.
		# Guests default off — force with: hyprluggage-hw-ensure set <profile> nvidia
		gpu=$(default_gpu)
	fi

	write_profile_stub "$profile"
	write_gpu_stub "$gpu"
}

cmd_set() {
	local profile gpu
	profile=$(normalize_profile "${1:-}")
	gpu=$(normalize_gpu "${2:-}")
	write_profile_stub "$profile"
	write_gpu_stub "$gpu"
	echo "profile=$profile gpu=$gpu"
}

cmd_detect() {
	local form=desktop gpu virt=no
	detect_laptop && form=laptop
	detect_vm && virt=yes
	gpu=$(default_gpu)
	echo "form=$form gpu=$gpu virt=$virt"
}

usage() {
	cat <<'EOF'
Usage: hyprluggage-hw-ensure <command>

  ensure              Write profile/gpu stubs if missing (or refresh from saved choice)
  set <profile> <gpu> Force profile (desktop|laptop) and gpu (nvidia|other)
  detect              Print detected form=, gpu=, virt= (no write)

Virtual machines: NVIDIA overlay is not auto-applied (use set … nvidia to opt in).
EOF
}

main() {
	local cmd="${1:-ensure}"
	shift || true
	case "$cmd" in
	ensure) cmd_ensure "$@" ;;
	set) cmd_set "$@" ;;
	detect) cmd_detect "$@" ;;
	-h | --help | help) usage ;;
	*)
		echo "unknown command: $cmd" >&2
		usage >&2
		exit 1
		;;
	esac
}

main "$@"
