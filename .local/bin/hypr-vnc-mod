#!/usr/bin/env bash
# Apply/clear CTRL+ALT twins of SUPER binds while VNC or Sunshine sessions are active.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"
export PATH="$HOME/.local/bin:/usr/bin:/bin:$PATH"

# Prefer real Wayland socket if unset
if [[ -z "${WAYLAND_DISPLAY}" ]]; then
  for d in wayland-1 wayland-0; do
    if [[ -S "${XDG_RUNTIME_DIR}/${d}" ]]; then
      export WAYLAND_DISPLAY="$d"
      break
    fi
  done
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
fi

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
GENERATED="$HYPR_DIR/vnc-mod-generated.lua"
GENERATED_CONF="$HYPR_DIR/vnc-mod-generated.conf"
# Outside the stowed ~/.config/hypr tree so apply/clear never dirties the git repo
ACTIVE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hyprluggage"
ACTIVE="$ACTIVE_DIR/vnc-mod-active.lua"
ACTIVE_CONF="$ACTIVE_DIR/vnc-mod-active.conf"
STATE_DIR="${XDG_RUNTIME_DIR}/wayvnc-vncmod"
STATE_FILE="$STATE_DIR/active"
HOLDERS_DIR="$STATE_DIR/holders"
GEN="${SCRIPT_DIR}/hypr-vnc-mod-gen.sh"

write_active_empty() {
  mkdir -p "$ACTIVE_DIR"
  cat > "$ACTIVE" << 'INNER'
-- Managed by hypr-vnc-mod — empty when no remote session (no extra binds)
INNER
  cat > "$ACTIVE_CONF" << 'INNER'
# Managed by hypr-vnc-mod — empty when no remote session (no extra binds)
INNER
}

write_active_source() {
  mkdir -p "$ACTIVE_DIR"
  cat > "$ACTIVE" << INNER
-- Managed by hypr-vnc-mod — loaded while VNC or Sunshine clients are connected
dofile("$GENERATED")
INNER
  cat > "$ACTIVE_CONF" << INNER
# Managed by hypr-vnc-mod — loaded while VNC or Sunshine clients are connected
source = $GENERATED_CONF
INNER
}

ensure_hypr_env() {
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    local inst
    inst="$(ls -1 "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -n1 || true)"
    if [[ -n "$inst" ]]; then
      export HYPRLAND_INSTANCE_SIGNATURE="$inst"
    fi
  fi
}

hypr_reload() {
  ensure_hypr_env
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    logger -t wayvnc-vncmod "hyprctl unavailable (no Hyprland instance); skipped reload"
    return 1
  fi
  hyprctl reload >/dev/null
}

normalize_reason() {
  local r="${1:-vnc}"
  case "$r" in
    vnc|sunshine) printf '%s\n' "$r" ;;
    *)
      echo "unknown reason: $r (expected vnc or sunshine)" >&2
      return 1
      ;;
  esac
}

holder_list() {
  shopt -s nullglob
  local f names=()
  for f in "$HOLDERS_DIR"/*; do
    [[ -f "$f" ]] || continue
    names+=("$(basename "$f")")
  done
  shopt -u nullglob
  if ((${#names[@]})); then
    printf '%s\n' "${names[*]}"
  fi
}

holder_count() {
  shopt -s nullglob
  local files=( "$HOLDERS_DIR"/* ) f n=0
  shopt -u nullglob
  for f in "${files[@]}"; do
    [[ -f "$f" ]] && n=$((n + 1))
  done
  printf '%s\n' "$n"
}

# Pre-holder STATE_FILE meant "VNC is holding the binds".
migrate_legacy_state() {
  mkdir -p "$HOLDERS_DIR" "$STATE_DIR"
  if [[ -f "$STATE_FILE" ]] && [[ "$(holder_count)" -eq 0 ]]; then
    touch "$HOLDERS_DIR/vnc"
  fi
}

binds_are_loaded() {
  [[ -f "$STATE_FILE" ]] && grep -q 'vnc-mod-generated' "$ACTIVE" 2>/dev/null
}

cmd_generate() {
  if [[ ! -x "$GEN" ]]; then
    echo "missing generator: $GEN" >&2
    return 1
  fi
  # Generator still reads .conf bind sources; emits both .conf seed and .lua for Hyprland
  "$GEN" "$GENERATED_CONF"
}

cmd_apply() {
  local reason
  reason="$(normalize_reason "${1:-vnc}")" || return 1
  migrate_legacy_state
  mkdir -p "$HOLDERS_DIR" "$STATE_DIR" "$HYPR_DIR"
  if binds_are_loaded; then
    touch "$HOLDERS_DIR/$reason"
    logger -t wayvnc-vncmod "holder added: $reason (binds already loaded)"
    echo "vnc-mod: applied ($reason; already loaded)"
    return 0
  fi
  cmd_generate
  write_active_source
  if hypr_reload; then
    touch "$STATE_FILE"
    touch "$HOLDERS_DIR/$reason"
    logger -t wayvnc-vncmod "applied CTRL+ALT remote binds ($reason)"
    echo "vnc-mod: applied ($reason; $(grep -cE '^\s*hl\.bind' "$GENERATED" 2>/dev/null || echo 0) binds)"
  else
    echo "vnc-mod: generated but hyprctl reload failed" >&2
    return 1
  fi
}

cmd_clear() {
  local reason
  reason="$(normalize_reason "${1:-vnc}")" || return 1
  migrate_legacy_state
  rm -f "$HOLDERS_DIR/$reason"
  if [[ "$(holder_count)" -gt 0 ]]; then
    logger -t wayvnc-vncmod "holder removed: $reason (still: $(holder_list))"
    echo "vnc-mod: $reason cleared (still held by $(holder_list))"
    return 0
  fi
  write_active_empty
  rm -f "$STATE_FILE"
  if hypr_reload 2>/dev/null; then
    logger -t wayvnc-vncmod "cleared remote mod binds (hyprctl reload)"
    echo "vnc-mod: cleared"
  else
    echo "vnc-mod: active file cleared (hyprctl reload skipped/failed)"
  fi
}

cmd_status() {
  migrate_legacy_state
  local holders
  holders="$(holder_list)"
  if [[ -f "$STATE_FILE" ]]; then
    if [[ -n "$holders" ]]; then
      echo "state: active (Ctrl+Alt binds loaded; holders: $holders)"
    else
      echo "state: active (Ctrl+Alt binds loaded)"
    fi
  else
    echo "state: inactive (desktop Super-only)"
  fi
  if [[ -f "$GENERATED" ]]; then
    echo "generated: $(grep -cE '^\s*hl\.bind' "$GENERATED" 2>/dev/null || echo 0) binds in $GENERATED"
  else
    echo "generated: missing (run: hypr-vnc-mod generate)"
  fi
  if [[ -f "$ACTIVE" ]] && grep -q 'vnc-mod-generated' "$ACTIVE" 2>/dev/null; then
    echo "active-file: dofile generated lua"
  else
    echo "active-file: empty/not sourcing"
  fi
  ensure_hypr_env
  echo "hyprland: ${HYPRLAND_INSTANCE_SIGNATURE:-not detected}"
  echo "scripts: $SCRIPT_DIR"
}

cmd_ensure() {
  # Fresh install / login: ensure stubs exist without enabling remote binds
  mkdir -p "$HYPR_DIR" "$STATE_DIR" "$HOLDERS_DIR" "$ACTIVE_DIR"
  if [[ ! -f "$ACTIVE" ]]; then
    write_active_empty
  fi
  if [[ ! -f "$GENERATED" ]]; then
    cmd_generate || true
  fi
  migrate_legacy_state
  # Never leave remote mode on after ensure unless a holder is live
  if grep -q 'vnc-mod-generated' "$ACTIVE" 2>/dev/null && [[ ! -f "$STATE_FILE" ]]; then
    write_active_empty || true
  fi
  echo "vnc-mod: ensure ok ($ACTIVE)"
}

case "${1:-}" in
  generate|gen) cmd_generate ;;
  apply) cmd_apply "${2:-vnc}" ;;
  clear) cmd_clear "${2:-vnc}" ;;
  status) cmd_status ;;
  ensure) cmd_ensure ;;
  *)
    echo "Usage: $0 {generate|apply|clear|status|ensure} [vnc|sunshine]" >&2
    echo "  Super stays Super locally; during VNC or Sunshine, CTRL+ALT mirrors Super binds." >&2
    exit 1
    ;;
esac
