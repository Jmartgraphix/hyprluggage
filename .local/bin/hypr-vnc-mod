#!/usr/bin/env bash
# Apply/clear CTRL+ALT twins of SUPER binds while VNC or Sunshine sessions are active.
#
# Twins stay loaded for the whole session (sourced from login via ensure + hyprland.lua).
# apply/clear only track holders for status/clipboard coordination — they do not
# hyprctl reload on connect, which was breaking wayvnc's virtual keyboard for Gatwy.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"
export PATH="$HOME/.local/bin:/usr/bin:/bin:$PATH"

# Prefer real Wayland socket if unset
if [[ -z "${WAYLAND_DISPLAY}" ]]; then
  for d in wayland-1 wayland-0; do
    if [[ -S "${XDG_RUNTIME_DIR}/${d}" ]]; then
      export WAYLAND_DISPLAY="$d"
      break
    fi
  done
  export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
fi

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
GENERATED="$HYPR_DIR/vnc-mod-generated.lua"
# Outside the stowed ~/.config/hypr tree so apply/clear never dirties the git repo
ACTIVE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hyprluggage"
ACTIVE="$ACTIVE_DIR/vnc-mod-active.lua"
STATE_DIR="${XDG_RUNTIME_DIR}/wayvnc-vncmod"
STATE_FILE="$STATE_DIR/active"
HOLDERS_DIR="$STATE_DIR/holders"
GEN="${SCRIPT_DIR}/hypr-vnc-mod-gen.sh"

write_active_source() {
  mkdir -p "$ACTIVE_DIR"
  cat > "$ACTIVE" << INNER
-- Managed by hypr-vnc-mod — Ctrl+Alt Super twins (always loaded for Gatwy/Moonlight)
dofile("$GENERATED")
INNER
}

ensure_hypr_env() {
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    local inst
    # Hyprland instance dirs are simple signatures; pick the first.
    inst="$(find "${XDG_RUNTIME_DIR}/hypr" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | head -n1 || true)"
    if [[ -n "$inst" ]]; then
      export HYPRLAND_INSTANCE_SIGNATURE="$inst"
    fi
  fi
}

hypr_reload() {
  ensure_hypr_env
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    logger -t wayvnc-vncmod "hyprctl unavailable (no Hyprland instance); skipped reload"
    return 1
  fi
  hyprctl reload >/dev/null
}

normalize_reason() {
  local r="${1:-vnc}"
  case "$r" in
    vnc|sunshine) printf '%s\n' "$r" ;;
    *)
      echo "unknown reason: $r (expected vnc or sunshine)" >&2
      return 1
      ;;
  esac
}

holder_list() {
  shopt -s nullglob
  local f names=()
  for f in "$HOLDERS_DIR"/*; do
    [[ -f "$f" ]] || continue
    names+=("$(basename "$f")")
  done
  shopt -u nullglob
  if ((${#names[@]})); then
    printf '%s\n' "${names[*]}"
  fi
}

holder_count() {
  shopt -s nullglob
  local files=( "$HOLDERS_DIR"/* ) f n=0
  shopt -u nullglob
  for f in "${files[@]}"; do
    [[ -f "$f" ]] && n=$((n + 1))
  done
  printf '%s\n' "$n"
}

# Pre-holder STATE_FILE meant "VNC is holding the binds".
migrate_legacy_state() {
  mkdir -p "$HOLDERS_DIR" "$STATE_DIR"
  if [[ -f "$STATE_FILE" ]] && [[ "$(holder_count)" -eq 0 ]]; then
    touch "$HOLDERS_DIR/vnc"
  fi
}

twins_sourced() {
  [[ -f "$ACTIVE" ]] && grep -q 'vnc-mod-generated' "$ACTIVE" 2>/dev/null
}

cmd_generate() {
  if [[ ! -x "$GEN" ]]; then
    echo "missing generator: $GEN" >&2
    return 1
  fi
  "$GEN" "$GENERATED"
}

cmd_apply() {
  local reason
  reason="$(normalize_reason "${1:-vnc}")" || return 1
  migrate_legacy_state
  mkdir -p "$HOLDERS_DIR" "$STATE_DIR" "$HYPR_DIR"

  # Ensure the map exists and the active stub points at it (no reload on connect).
  if [[ ! -f "$GENERATED" ]]; then
    cmd_generate || true
  fi
  if ! twins_sourced; then
    write_active_source
    # First time this session: load twins. Prefer not to reload if already live.
    hypr_reload || true
  fi

  touch "$STATE_FILE"
  touch "$HOLDERS_DIR/$reason"
  logger -t wayvnc-vncmod "holder added: $reason (Ctrl+Alt twins ready)"
  echo "vnc-mod: applied ($reason; $(grep -cE '^\s*hl\.bind' "$GENERATED" 2>/dev/null || echo 0) binds)"
}

cmd_clear() {
  local reason
  reason="$(normalize_reason "${1:-vnc}")" || return 1
  migrate_legacy_state
  rm -f "$HOLDERS_DIR/$reason"
  if [[ "$(holder_count)" -gt 0 ]]; then
    logger -t wayvnc-vncmod "holder removed: $reason (still: $(holder_list))"
    echo "vnc-mod: $reason cleared (still held by $(holder_list))"
    return 0
  fi
  # Keep Ctrl+Alt twins loaded — unloading required a reload that broke Gatwy input.
  rm -f "$STATE_FILE"
  logger -t wayvnc-vncmod "cleared holders (twins stay loaded)"
  echo "vnc-mod: cleared holders (Ctrl+Alt twins stay loaded)"
}

cmd_status() {
  migrate_legacy_state
  local holders
  holders="$(holder_list)"
  if twins_sourced; then
    echo "twins: loaded ($(grep -cE '^\s*hl\.bind' "$GENERATED" 2>/dev/null || echo 0) binds)"
  else
    echo "twins: not sourced (run: hypr-vnc-mod ensure)"
  fi
  if [[ -f "$STATE_FILE" ]] || [[ -n "$holders" ]]; then
    echo "holders: ${holders:-none} (remote session marker)"
  else
    echo "holders: none"
  fi
  if [[ -f "$GENERATED" ]]; then
    echo "generated: $GENERATED"
  else
    echo "generated: missing (run: hypr-vnc-mod generate)"
  fi
  ensure_hypr_env
  echo "hyprland: ${HYPRLAND_INSTANCE_SIGNATURE:-not detected}"
  echo "scripts: $SCRIPT_DIR"
}

cmd_ensure() {
  # Session start / install: generate map and always source it (no empty stub).
  mkdir -p "$HYPR_DIR" "$STATE_DIR" "$HOLDERS_DIR" "$ACTIVE_DIR"
  cmd_generate || true
  write_active_source
  migrate_legacy_state
  echo "vnc-mod: ensure ok (twins sourced from $GENERATED)"
}

case "${1:-}" in
  generate|gen) cmd_generate ;;
  apply) cmd_apply "${2:-vnc}" ;;
  clear) cmd_clear "${2:-vnc}" ;;
  status) cmd_status ;;
  ensure) cmd_ensure ;;
  *)
    echo "Usage: $0 {generate|apply|clear|status|ensure} [vnc|sunshine]" >&2
    echo "  Ctrl+Alt twins stay loaded; apply/clear track remote holders only." >&2
    exit 1
    ;;
esac
