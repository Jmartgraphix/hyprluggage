*.bak

# Runtime VNC toggle (lives in ~/.local/state; ignore legacy stowed path if present)
.config/hypr/vnc-mod-active.conf

# Runtime symlinks created by hyprluggage hooks
.config/waybar/colors.css
.config/rofi/colors.rasi
.config/mako/config

# systemctl --user enable writes these into the stowed folder
.config/systemd/user/*.wants/
.config/systemd/user/*.requires/

# uwsm select saves this into the stowed ~/.config/uwsm folder
.config/uwsm/default-id

# Launcher favorites, aliases, and hidden apps (created on first run)
.config/rofi/launcher/

# Python bytecode (launcher compiles on first run)
__pycache__/
*.pyc
.config/yazi/theme.toml
.config/btop/themes/current.theme
.config/rmpc/themes/current.ron
.config/rmpc/themes/pywall16.ron
.config/gtk-3.0/colors.css
.config/gtk-4.0/colors.css
.config/gtk-3.0/bookmarks
.config/gtk-4.0/bookmarks

# Matugen rewrites these from the wallpaper. baseline/ is the shipped seed.
# user.css is hand-written, so it stays tracked.
themes/dynamic/.config/**
themes/dynamic/.cache/**
!themes/dynamic/.config/spicetify/
!themes/dynamic/.config/spicetify/Themes/
!themes/dynamic/.config/spicetify/Themes/hyprluggage/
!themes/dynamic/.config/spicetify/Themes/hyprluggage/user.css

# Theme wallpaper symlinks (user preference, changes frequently)
themes/*/wallpaper

# User-imported omarchy/omakub themes
themes/* \(*\)/

.config/tmux/plugins

# Fish local config
.config/fish/fish_variables
.config/fish/install.log
.config/fish/api.fish
.config/fish/completions/grok.fish

# Typora - ignore everything except custom themes
.config/Typora/*
!.config/Typora/themes/
.config/Typora/themes/*
!.config/Typora/themes/ia_typora.css
!.config/Typora/themes/ia_typora_night.css
