[Unit]
Description=VNC session hooks: clipboard pause + Hyprland Ctrl+Alt binds
After=wayvnc.service graphical-session.target
PartOf=graphical-session.target
Wants=wayvnc.service

[Service]
Type=simple
ExecStart=%h/.local/bin/wayvnc-clipboard-bridge.sh
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
