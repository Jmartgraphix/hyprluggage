#!/bin/bash
# Wallpaper picker — unique relative paths + thumbnails.

source "$HOME/.config/hypr/scripts/wallpaper-lib.sh"
source "$HOME/.config/rofi/scripts/thumbcache"

wallpaper_dir="$HOME/Wallpapers"
awww_params=(
	--transition-fps 120
	--transition-type center
	--transition-pos bottom
	--transition-duration 1
	--transition-bezier 0.25,0.1,0.25,1.0
)

mapfile -d '' wallpapers < <(
	find "$wallpaper_dir" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" \) -print0 | sort -z
)

if [[ ${#wallpapers[@]} -eq 0 ]]; then
	(
		action=$(notify-send -A "open=Get Wallpapers" --wait "No Wallpapers Found" "Add images to ~/Wallpapers to use dynamic theming")
		[[ "$action" == "open" ]] && xdg-open "https://github.com/Jmartgraphix/Wallpapers"
	) &
	exit 1
fi

menu() {
	local wp rel thumb
	for wp in "${wallpapers[@]}"; do
		rel="${wp#"$wallpaper_dir"/}"
		thumb=$(get_thumb "$wp")
		[[ -z "$thumb" ]] && thumb=$wp
		printf '%s\0icon\x1f%s\n' "$rel" "$thumb"
	done
}

# No notify before open (steals focus). No ${var%%$'\0'*} (bash NUL wipe bug).

choice=$(menu | "$HOME/.config/rofi/scripts/rofi-dmenu.sh" \
	-config "$HOME/.config/rofi/custom-rofi/config-wallpaper.rasi") || exit 0

[[ -z "$choice" ]] && exit 0

wp="$wallpaper_dir/$choice"
if [[ ! -f "$wp" ]]; then
	notify-send "Wallpaper not found" "$choice"
	exit 1
fi

apply_wallpaper "$wp" "${awww_params[@]}"
notify-send -i "$wp" "Wallpaper" "$choice"
