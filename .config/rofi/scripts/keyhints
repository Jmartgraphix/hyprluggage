#!/bin/bash
# keyhints - show hyprland keybindings
# During Gatwy/VNC sessions (hypr-vnc-mod active), show only Ctrl+Alt binds.

if pidof rofi >/dev/null; then
  pkill rofi
  exit
fi

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
VNC_STATE="${XDG_RUNTIME_DIR}/wayvnc-vncmod/active"

if [[ -f "$VNC_STATE" ]]; then
  PROMPT="VNC keybinds (Ctrl+Alt)"
  # Only remote-usable chords from hypr-vnc-mod
  filter_list() { grep -E 'CTRL ALT'; }
else
  PROMPT=""
  filter_list() { cat; }
fi

# Hyprland 0.56 broke `hyprctl binds -j`; parse the stable text output instead.
hyprctl binds | awk '
BEGIN {
    keymap[10] = "1"; keymap[11] = "2"; keymap[12] = "3"; keymap[13] = "4";
    keymap[14] = "5"; keymap[15] = "6"; keymap[16] = "7"; keymap[17] = "8";
    keymap[18] = "9"; keymap[19] = "0"; keymap[20] = "-"; keymap[21] = "=";

    modmap[0] = "";
    modmap[1] = "SHIFT";
    modmap[4] = "CTRL";
    modmap[5] = "SHIFT CTRL";
    modmap[8] = "ALT";
    modmap[9] = "SHIFT ALT";
    modmap[12] = "CTRL ALT";
    modmap[13] = "SHIFT CTRL ALT";
    modmap[64] = "SUPER";
    modmap[65] = "SUPER SHIFT";
    modmap[68] = "SUPER CTRL";
    modmap[69] = "SUPER SHIFT CTRL";
    modmap[72] = "SUPER ALT";
    modmap[73] = "SUPER SHIFT ALT";
    modmap[76] = "SUPER CTRL ALT";
    modmap[77] = "SUPER SHIFT CTRL ALT";

    mousemap[272] = "LEFT CLICK";
    mousemap[273] = "RIGHT CLICK";
    mousemap[274] = "MIDDLE CLICK";
}
function trim(s) {
    sub(/^[ \t]+/, "", s);
    sub(/[ \t]+$/, "", s);
    return s;
}
function print_bind(    mod, label, description) {
    if (key == "" && keycode != "" && keycode != "0" && keycode in keymap) {
        key = keymap[keycode];
    }

    if (key ~ /^mouse:/) {
        mousecode = substr(key, 7);
        if (mousecode in mousemap) {
            key = mousemap[mousecode];
        }
    }

    description = desc;
    if (description == "") {
        description = dispatcher;
        if (arg != "") {
            gsub(/^exec, /, "", arg);
            gsub(/uwsm app -- /, "", arg);
            gsub(/uwsm-app -- /, "", arg);
            if (length(arg) <= 40) {
                description = dispatcher " " arg;
            }
        }
    }

    mod = (modmask in modmap) ? modmap[modmask] : modmask;
    mod = trim(mod);

    if (mod != "") {
        label = mod " + " key;
    } else {
        label = key;
    }

    printf "%-35s → %s\n", label, description;
}
/^bind/ {
    if (key != "" || dispatcher != "") {
        print_bind();
    }
    modmask = "";
    key = "";
    keycode = "";
    desc = "";
    dispatcher = "";
    arg = "";
    next;
}
/^[[:space:]]+modmask:/ {
    modmask = $2;
    next;
}
/^[[:space:]]+key:/ {
    key = $2;
    next;
}
/^[[:space:]]+keycode:/ {
    keycode = $2;
    next;
}
/^[[:space:]]+description:/ {
    $1 = "";
    desc = trim($0);
    next;
}
/^[[:space:]]+dispatcher:/ {
    dispatcher = $2;
    next;
}
/^[[:space:]]+arg:/ {
    $1 = "";
    arg = trim($0);
    next;
}
END {
    if (key != "" || dispatcher != "") {
        print_bind();
    }
}
' | sort -u | filter_list | rofi -dmenu -i -p "$PROMPT" -config ~/.config/rofi/custom-rofi/config-keybinds.rasi
