#!/bin/bash
# wallpaper picker with dynamic color generation

source "$HOME/.config/hypr/scripts/wallpaper-lib.sh"

current_theme=$(current_hyprluggage_theme)
if [[ "$current_theme" != "dynamic" ]]; then
	notify-send "Theme Locked" "Switch to Dynamic first"
	exit 0
fi

wallpaper_dir="$HOME/Wallpapers"
awww_params=(
	--transition-fps 120
	--transition-type grow
	--transition-duration 1
	--transition-bezier "0.25,0.1,0.25,1.0"
	--transition-pos top-right
)

mapfile -d '' wallpapers < <(find "$wallpaper_dir" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" \) -print0)

if [[ ${#wallpapers[@]} -eq 0 ]]; then
	(action=$(notify-send -A "open=Get Wallpapers" --wait "No Wallpapers Found" "Add images to ~/Wallpapers to use dynamic theming") && [[ "$action" == "open" ]] && xdg-open "https://github.com/Jmartgraphix/Wallpapers") &
	exit 1
fi

# build rofi menu with thumbnails
menu() {
	for wp in "${wallpapers[@]}"; do
		name=$(basename "$wp")
		printf "%s\x00icon\x1f%s\n" "$name" "$wp"
	done | sort
}

ensure_awww_daemon

choice=$(menu | rofi -i -dmenu -p "" -config ~/.config/rofi/custom-rofi/config-wallpaper.rasi)
[[ -z "$choice" ]] && exit 0

# find and apply selected wallpaper
for wp in "${wallpapers[@]}"; do
	if [[ "$(basename "$wp")" == "$choice" ]]; then
		# Sets the wallpaper and hyprlock link, runs matugen with -p <repo>,
		# reloads mako and hyprluggage. Matugen must never run without -p.
		rc=0
		apply_wallpaper "$wp" "${awww_params[@]}" || rc=$?
		if ((rc == 1)); then
			notify-send "Wallpaper failed" "$choice"
		fi
		((rc == 0)) || exit 1   # rc 2: apply_wallpaper already said "Matugen failed"
		command -v restart-app &>/dev/null && restart-app swayosd-server || true

		# nautilus needs full restart to pick up new gtk theme
		pgrep -x nautilus >/dev/null && (
			pkill -x nautilus
			nautilus &>/dev/null &
		)

		notify-send -i "$wp" "Dynamic" "Colors from wallpaper"
		break
	fi
done
