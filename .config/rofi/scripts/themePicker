#!/bin/bash
# Theme picker — single horizontal bar, one click to apply.

source "$(dirname "$0")/thumbcache"

repo_dir="$("$HOME/.config/hypr/scripts/hyprluggage-dir")"
themes_dir="$repo_dir/themes"
hyprluggage="$repo_dir/install/themes/hyprluggage"
current_theme=$(cat "$HOME/.config/hyprluggage/.current-theme" 2>/dev/null || echo "dynamic")

if command -v hyprctl &>/dev/null; then
	mon_width=$(hyprctl monitors -j 2>/dev/null | jq '.[0].width // 1920' 2>/dev/null || echo 1920)
else
	mon_width=1920
fi
[[ "$mon_width" =~ ^[0-9]+$ ]] || mon_width=1920

cols=$(( (mon_width * 80 / 100) / 200 ))
[[ $cols -lt 3 ]] && cols=3
[[ $cols -gt 6 ]] && cols=6

get_preview() {
	local dir="$1"
	[[ -f "$dir/preview.png" ]] && { echo "$dir/preview.png"; return; }
	[[ -f "$dir/preview.jpg" ]] && { echo "$dir/preview.jpg"; return; }
	local wall
	wall=$(find "$dir/backgrounds" -type f \( -name "*.jpg" -o -name "*.png" -o -name "*.webp" \) 2>/dev/null | sort -V | head -1)
	[[ -n "$wall" ]] && { echo "$wall"; return; }
	[[ -L "$dir/wallpaper" ]] && readlink -f "$dir/wallpaper"
}

menu() {
	local dir name preview thumb
	local -a names=()
	mapfile -t names < <(
		for dir in "$themes_dir"/*/; do
			name=$(basename "$dir")
			[[ "$name" == "Wallpapers" || "$name" == ".git" ]] && continue
			[[ -d "$dir/.config" ]] || continue
			printf '%s\n' "$name"
		done | LC_ALL=C sort
	)
	for name in "${names[@]}"; do
		dir="$themes_dir/$name"
		preview=$(get_preview "$dir")
		[[ -z "$preview" ]] && continue
		thumb=$(get_thumb "$preview")
		[[ -z "$thumb" ]] && thumb=$preview
		printf '%s\0icon\x1f%s\n' "$name" "$thumb"
	done
}

# No notify-send before open — it steals focus and dismisses rofi.
# Do NOT strip with ${var%%$'\0'*} — bash treats NUL in patterns as
# empty, which wipes the entire selection (picker looks broken).

choice=$(menu | "$HOME/.config/rofi/scripts/rofi-dmenu.sh" \
	-hover-select \
	-me-select-entry '' \
	-me-accept-entry MousePrimary \
	-theme-str "listview{columns:$cols;}" \
	-config "$HOME/.config/rofi/custom-rofi/config-theme-picker.rasi") || exit 0

[[ -z "$choice" ]] && exit 0

# Trim CR/whitespace from rofi output.
choice="${choice//$'\r'/}"
choice="${choice#"${choice%%[![:space:]]*}"}"
choice="${choice%"${choice##*[![:space:]]}"}"

if [[ "$choice" == "$current_theme" ]]; then
	notify-send -a Hyprluggage "Already using $choice"
	exit 0
fi

if [[ ! -d "$themes_dir/$choice" ]]; then
	notify-send -a Hyprluggage "Theme not found" "$choice"
	exit 1
fi

# Detach from waybar's cgroup when launched via on-click. Otherwise a waybar
# restart/reload in the same unit can still race and kill the switch before
# the toast. systemd-run puts it in a transient scope of its own.
if command -v systemd-run >/dev/null; then
	exec systemd-run --user --quiet --collect \
		-E WAYLAND_DISPLAY -E DISPLAY -E DBUS_SESSION_BUS_ADDRESS \
		-E XDG_RUNTIME_DIR -E HYPRLAND_INSTANCE_SIGNATURE \
		"$hyprluggage" switch "$choice"
fi

exec "$hyprluggage" switch "$choice"
