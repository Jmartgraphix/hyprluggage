#!/bin/bash
# Waybar icon for monitor brightness. This desktop has no laptop backlight;
# ddc-brightness writes the percent after each change.

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprluggage"
mon="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true).name // empty' | head -1)"
[[ -z "$mon" ]] && mon="DP-1"

pct=""
[[ -f "$cache_dir/brightness-$mon" ]] && pct="$(<"$cache_dir/brightness-$mon")"

icons=("󰃜" "󰃝" "󰃞" "󰃟" "󰃠")
if [[ ! "$pct" =~ ^[0-9]+$ ]]; then
	printf '%s\n' "{\"text\": \"${icons[2]}\", \"tooltip\": \"Brightness unavailable\"}"
	exit 0
fi
((pct > 100)) && pct=100
idx=$((pct * 4 / 100))
printf '%s\n' "{\"text\": \"${icons[$idx]}\", \"tooltip\": \"$mon ${pct}%. Scroll to change.\"}"
