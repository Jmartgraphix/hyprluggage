#!/bin/bash
# Waybar icon for monitor brightness. This desktop has no laptop backlight;
# ddc-brightness writes the percent after each change.

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hyprluggage"
mon="$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true).name // empty' | head -1)"
if [[ -z "$mon" ]]; then
	mon="$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].name // empty' | head -1)"
fi

pct=""
[[ -f "$cache_dir/brightness-$mon" ]] && pct="$(<"$cache_dir/brightness-$mon")"

night_temp="$(hyprctl hyprsunset temperature 2>/dev/null | grep -oE '[0-9]+' | head -1)"
if [[ "$night_temp" =~ ^[0-9]+$ && "$night_temp" -lt 6000 ]]; then
	night="Nightlight on. Right-click to toggle."
else
	night="Nightlight off. Right-click to toggle."
fi

icons=("󰃜" "󰃝" "󰃞" "󰃟" "󰃠")
if [[ ! "$pct" =~ ^[0-9]+$ ]]; then
	printf '%s\n' "{\"text\": \"${icons[2]}\", \"tooltip\": \"Brightness unavailable. $night\"}"
	exit 0
fi
((pct > 100)) && pct=100
idx=$((pct * 4 / 100))
printf '%s\n' "{\"text\": \"${icons[$idx]}\", \"tooltip\": \"$mon ${pct}%. Scroll to change. $night\"}"
