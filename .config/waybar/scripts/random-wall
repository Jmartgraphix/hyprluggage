#!/bin/bash
# Waybar middle-click on the theme icon → random wallpaper

source "$HOME/.config/hypr/scripts/wallpaper-lib.sh"

wallpaper_dir="$HOME/Wallpapers"

mapfile -t wallpapers < <(
	find "$wallpaper_dir" -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" \) | sort
)

if [[ ${#wallpapers[@]} -eq 0 ]]; then
	(
		action=$(notify-send -A "open=Get Wallpapers" --wait "No Wallpapers Found" "Add images to ~/Wallpapers to use dynamic theming")
		[[ "$action" == "open" ]] && xdg-open "https://github.com/Jmartgraphix/Wallpapers"
	) &
	exit 1
fi

selected="${wallpapers[$((RANDOM % ${#wallpapers[@]}))]}"

apply_wallpaper "$selected" \
	--transition-type grow \
	--transition-pos top-right \
	--transition-fps 120 \
	--transition-duration 1 \
	--transition-bezier 0.25,0.1,0.25,1.0

notify-send -i "$selected" "Random Wallpaper" "${selected#"$wallpaper_dir"/}"
