#!/bin/bash
# Random dynamic wallpaper + matugen. Locked out on static themes.

source "$HOME/.config/hypr/scripts/wallpaper-lib.sh"

CURRENT_THEME=$(current_hyprluggage_theme)
if [[ "$CURRENT_THEME" != "dynamic" ]]; then
	notify-send "Theme Locked" "Switch to Dynamic first"
	exit 0
fi

WALLPAPER_DIR="$HOME/Wallpapers/"
STATE_FILE="$HOME/.current_wallpaper_index"

mapfile -t WALLPAPERS < <(find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.png' \) | sort)

NUM_WALLPAPERS=${#WALLPAPERS[@]}
if [[ "$NUM_WALLPAPERS" -eq 0 ]]; then
	(
		action=$(notify-send -A "open=Get Wallpapers" --wait "No Wallpapers Found" "Add images to ~/Wallpapers to use dynamic theming")
		[[ "$action" == "open" ]] && xdg-open "https://github.com/Jmartgraphix/Wallpapers"
	) &
	exit 1
fi

INDEX=$((RANDOM % NUM_WALLPAPERS))
echo "$INDEX" >"$STATE_FILE"
CURRENT_WALLPAPER="${WALLPAPERS[$INDEX]}"

apply_wallpaper "$CURRENT_WALLPAPER" \
	--transition-type center \
	--transition-pos top-right \
	--transition-fps 120 \
	--transition-duration 1 \
	--transition-bezier 0.25,0.1,0.25,1.0

# Extra session refresh for dynamic (apply_wallpaper already reloads hyprluggage).
command -v restart-app &>/dev/null && restart-app swayosd-server || true
pgrep -x nautilus >/dev/null && (
	pkill -x nautilus
	nautilus &>/dev/null &
	disown
)

notify-send -i "$CURRENT_WALLPAPER" "Dynamic" "Colors from wallpaper"
