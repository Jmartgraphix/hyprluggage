#!/bin/bash

# Graceful shutdown - closes all windows before powering off
# This allows apps like Chrome/browsers to save state properly
# Confirm first. A second call within 2 seconds skips the prompt.

scrDir="$(cd "$(dirname "$0")" && pwd)"
"$scrDir/power-confirm" shutdown "Shut down" || exit 0

# Close all Hyprland windows gracefully
close_all_windows() {
  hyprctl clients -j | jq -r ".[].address" | while read -r addr; do
    hyprctl dispatch closewindow address:"$addr" 2>/dev/null
  done
}

# Close all windows
close_all_windows

# Wait for apps to save their state (especially browsers)
sleep 1

# Power off without wall message
systemctl poweroff --no-wall
