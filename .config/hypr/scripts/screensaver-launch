#!/bin/bash

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensaver is already running
pgrep -f "alacritty --class Screensaver" && exit 0

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')

# Hyprland 0.55 Lua: hyprctl dispatch takes hl.dsp.* calls, not legacy "focusmonitor DP-1"
focus_monitor() {
  local name="$1"
  [[ -n "$name" ]] || return 0
  hyprctl dispatch "hl.dsp.focus({ monitor = \"${name}\" })"
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  focus_monitor "$m"

  # Alacritty is the screensaver host (not the user's working terminal)
  alacritty --class Screensaver \
    --config-file "$HOME/.config/alacritty/screensaver.toml" \
    -e "$HOME/.config/hypr/scripts/screensaver" &
done

focus_monitor "$focused"
